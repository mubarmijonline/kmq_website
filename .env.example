# Copy to .env and fill in. .env is never committed.

# Flask session signing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when KMQ_ENV=prod, and the app refuses to boot without it: the
# random fallback gives each gunicorn worker a different key, which would sign
# admins out on alternate requests.
SECRET_KEY=

# Salt for the IP hash used to throttle the lead form. Per-deployment, so
# hashes are not comparable across sites. Generate the same way.
IP_HASH_SALT=

# PostgreSQL. Leave unset in development to run the site without a database:
# 24 of the 26 pages never touch it, and the other two degrade to a notice.
DATABASE_URL=postgresql:///kmq

# The business's WhatsApp number, in any format — digits are extracted.
# LEAVE THIS UNSET until KMQ supplies the real number. With it unset every
# WhatsApp CTA falls back to the contact form, which is the honest default;
# the design file shipped 966500000000, which is not KMQ's number.
KMQ_WHATSAPP=

# Feature switches the design file exposed as settings.
KMQ_SHOW_PRICES=true

# The client's Google Analytics 4 measurement id. The tag renders only when
# KMQ_ENV=prod, so a dev process never counts itself as a visitor in the
# client's numbers. Set this empty to switch analytics off in production.
KMQ_GA_ID=G-Z12Q4Y5EQZ

# The Meta (Facebook and Instagram) pixel. Normally left unset here and typed
# into the admin under Settings; setting it pins the value, and the admin's
# field goes read-only. Empty and unset both mean the pixel does not fire.
KMQ_META_PIXEL=

# "prod" turns off dev asset rebuilding and turns on secure cookies.
KMQ_ENV=dev
