# Copy to .env and fill in. .env is never committed.

# Flask session signing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Salt for the IP hash used to throttle the lead form. Per-deployment, so
# hashes are not comparable across sites. Generate the same way.
IP_HASH_SALT=

# PostgreSQL. Leave unset in development to run the site without a database:
# 24 of the 26 pages never touch it, and the other two degrade to a notice.
DATABASE_URL=postgresql:///kmq

# The business's WhatsApp number, in any format — digits are extracted.
# LEAVE THIS UNSET until KMQ supplies the real number. With it unset every
# WhatsApp CTA falls back to the contact form, which is the honest default;
# the design file shipped 966500000000, which is not KMQ's number.
KMQ_WHATSAPP=

# Feature switches the design file exposed as settings.
KMQ_SHOW_PRICES=true

# "prod" turns off dev asset rebuilding and turns on secure cookies.
KMQ_ENV=dev
